# ===== Claude 自动注册 —— 环境变量配置 =====

# 第四步（验证 Magic Link 创建账号）需要两个验证码 token，按优先级自动获取：
# 1. 手动抓包：浏览器打开 Magic Link，页面自动完成验证后，F12 → Network 面板，
#    抓取 verify_magic_link 请求体中的（token 不可伪造，只能手动/打码获取）：
#    - arkose_session_token：Arkose/FunCaptcha 会话 token
#    - client_attestation.hcaptcha_token：hCaptcha 挑战 token
# 2. 打码服务：配置下方 CAPTCHA_PROVIDER_KEY 后自动获取（推荐，全自动）

# ARKOSE_SESSION_TOKEN=
# HCAPTCHA_TOKEN=

# ===== 打码服务配置（可选；配置后未填 token 时自动获取）=====
# 服务商：capsolver | 2captcha | yescaptcha，需注册获取 API Key
# ⚠️ 请勿把真实 Key 填在此文件（可能被提交到仓库），复制到 .env 中使用
# 实测最优组合（双服务商）：hCaptcha 用 yescaptcha（秒解 ~18s），
# Arkose 用 2captcha（秒解 ~5s，yescaptcha 不支持 Arkose）
# CAPTCHA_PROVIDER=yescaptcha
# CAPTCHA_PROVIDER_KEY=YOUR_CAPTCHA_PROVIDER_KEY
# Arkose/FunCaptcha 独立服务商（可选，默认同 CAPTCHA_PROVIDER）：
# ARKOSE_PROVIDER=2captcha
# ARKOSE_PROVIDER_KEY=YOUR_2CAPTCHA_API_KEY
# hCaptcha sitekey（一般从 Magic Link 页面自动提取，失败时手动指定）
# 浏览器打开 Magic Link → F12 → 搜索 sitekey 即可看到（claude.ai 固定值 a8086506-2036-46f4-ae50-00d8be805efa）
# HCAPTCHA_SITEKEY=a8086506-2036-46f4-ae50-00d8be805efa
# 单打码任务超时（毫秒，默认 600000=10 分钟；hCaptcha 任务实测可能耗时 3-5 分钟）
# CAPTCHA_TASK_TIMEOUT_MS=600000
# 打码任务失败/超时后的重试次数（默认 3，即最多尝试 4 次；hCaptcha 偶发无解且耗时长，重试可提高成功率）
# CAPTCHA_TASK_RETRIES=3

# ===== 高级配置（可选，注释掉即使用默认值）=====

# 邮箱服务登录 Cookie（默认在 src/services/mailService.js 中维护）：
# MAIL_COOKIE=chaip_session=xxx

# Claude 登录 Cookie（默认在 src/services/claudeService.js 中维护）：
# CLAUDE_COOKIE=cf_clearance=xxx; __cf_bm=xxx
